{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://layoutdna.local/schemas/scene.schema.json",
  "title": "LayoutDNA Scene",
  "description": "Versioned, normalized layout exchange format. Element geometry is normalized to the source canvas while source dimensions remain in pixels.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "canvas", "elements"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "backgroundColor": { "$ref": "#/$defs/color" }
      }
    },
    "elements": {
      "type": "array",
      "items": { "$ref": "#/$defs/element" }
    }
  },
  "$defs": {
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": ["r", "g", "b", "a"],
      "properties": {
        "r": { "type": "number", "minimum": 0, "maximum": 1 },
        "g": { "type": "number", "minimum": 0, "maximum": 1 },
        "b": { "type": "number", "minimum": 0, "maximum": 1 },
        "a": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "semanticRole", "x", "y", "width", "height", "rotation", "zIndex", "visible", "optional", "visual", "constraints", "groupAffinities"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["text", "image", "shape", "group", "unknown"] },
        "semanticRole": { "enum": ["headline", "subhead", "body", "cta", "logo", "hero", "decoration", "background", "unknown"] },
        "parentId": { "type": ["string", "null"] },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 },
        "rotation": { "type": "number" },
        "zIndex": { "type": "integer" },
        "visible": { "type": "boolean" },
        "optional": { "type": "boolean" },
        "text": {
          "type": "object",
          "additionalProperties": false,
          "required": ["content"],
          "properties": {
            "content": { "type": "string" },
            "fontSize": { "type": "number", "exclusiveMinimum": 0 },
            "fontWeight": { "type": "number", "minimum": 1 },
            "lineHeight": { "type": "number", "exclusiveMinimum": 0 },
            "align": { "enum": ["left", "center", "right", "justify"] }
          }
        },
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "required": ["opacity", "luminance", "colorCoverage"],
          "properties": {
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
            "luminance": { "type": "number", "minimum": 0, "maximum": 1 },
            "colorCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
            "fill": { "$ref": "#/$defs/color" }
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minWidth": { "type": "number", "minimum": 0 },
            "minHeight": { "type": "number", "minimum": 0 },
            "fixedAspectRatio": { "type": "boolean" },
            "lockedPosition": { "type": "boolean" },
            "logoClearSpace": { "type": "number", "minimum": 0 },
            "mandatoryOnCanvas": { "type": "boolean" }
          }
        },
        "readingOrder": { "type": ["integer", "null"], "minimum": 0 },
        "groupAffinities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    }
  }
}

