{
  "testId": "layout-dna-local-dev",
  "name": "LayoutDNA",
  "version": "0.1.0",
  "manifestVersion": 2,
  "requirements": {
    "apps": [
      {
        "name": "Express",
        "apiVersion": 1,
        "supportedDeviceClass": ["desktop"]
      }
    ],
    "supportsTouch": false
  },
  "entryPoints": [
    {
      "type": "panel",
      "id": "layoutDnaPanel",
      "main": "index.html",
      "documentSandbox": "code.js"
    }
  ]
}
